@tool
class_name DbCodegen
extends RefCounted
## Generates a typed helper class for every model: field and relation name constants,
## find(), and a typed query. Run it with generate.gd, or from code with [method run].
##
## Settings (Project Settings, advanced):
## [br]- [code]sqlite_orm/generator/output_dir[/code]: where files go, default
## [constant DEFAULT_OUTPUT_DIR].
## [br]- [code]sqlite_orm/generator/exclude[/code]: folders whose models are skipped, default
## [code]["res://addons"][/code].
## [br]- [code]sqlite_orm/generator/run_on_save[/code]: the editor plugin regenerates when a
## model is saved, default true.

const MARKER: String = "# GENERATED by sqlite_orm"
const DEFAULT_OUTPUT_DIR: String = "res://sqlite_orm_generated"
const OUTPUT_DIR_SETTING: String = "sqlite_orm/generator/output_dir"
const EXCLUDE_SETTING: String = "sqlite_orm/generator/exclude"
const RUN_ON_SAVE_SETTING: String = "sqlite_orm/generator/run_on_save"
const MAX_LINE: int = 100
const SCALAR_KINDS: Array[DbColumn.Kind] = [
    DbColumn.Kind.INT,
    DbColumn.Kind.FLOAT,
    DbColumn.Kind.STRING,
    DbColumn.Kind.STRING_NAME,
]
const QUERY_METHODS: Array[String] = [
    "where_group",
    "or_where_group",
    "where_raw",
    "limit",
    "offset",
    "all",
    "first",
    "count",
    "exists",
    "to_sql",
    "db_query",
]
const UPDATE_METHODS: Array[String] = [
    "where_group",
    "or_where_group",
    "where_raw",
    "all_rows",
    "execute",
    "db_update",
]
const DELETE_METHODS: Array[String] = [
    "where_group",
    "or_where_group",
    "where_raw",
    "all_rows",
    "execute",
    "db_delete",
]


## Generates every model's file, or with [param check] only reports what is missing or stale.
static func run(check: bool) -> Report:
    var report: Report = Report.new()
    var output_dir: String = output_dir_setting()
    var exclude: PackedStringArray = exclude_setting()
    exclude.append(output_dir)
    var built: Dictionary = build(find_models(exclude), output_dir)
    var errors: PackedStringArray = built["errors"]
    report.errors = errors
    if not report.errors.is_empty():
        return report
    var files: Dictionary = built["files"]
    for path: String in files:
        var source: String = files[path]
        var current: String = ""
        if FileAccess.file_exists(path):
            current = FileAccess.get_file_as_string(path)
        if current == source:
            continue
        report.changed.append(path)
        if not check:
            DirAccess.make_dir_recursive_absolute(path.get_base_dir())
            var file: FileAccess = FileAccess.open(path, FileAccess.WRITE)
            if file == null:
                report.errors.append(
                    "cannot write %s: %s" % [path, error_string(FileAccess.get_open_error())]
                )
                continue
            file.store_string(source)
            file.close()
    for path: String in _generated_files(output_dir):
        if files.has(path):
            continue
        report.removed.append(path)
        if not check:
            DirAccess.remove_absolute(path)
            if FileAccess.file_exists(path + ".uid"):
                DirAccess.remove_absolute(path + ".uid")
    return report


static func output_dir_setting() -> String:
    var value: Variant = ProjectSettings.get_setting(OUTPUT_DIR_SETTING, DEFAULT_OUTPUT_DIR)
    return str(value).trim_suffix("/")


static func exclude_setting() -> PackedStringArray:
    var value: Variant = ProjectSettings.get_setting(
        EXCLUDE_SETTING,
        PackedStringArray(["res://addons"]),
    )
    var folders: PackedStringArray = []
    if value is PackedStringArray:
        var packed: PackedStringArray = value
        for item: String in packed:
            folders.append(item.trim_suffix("/"))
    elif value is Array:
        var items: Array = value
        for item: Variant in items:
            folders.append(str(item).trim_suffix("/"))
    return folders


static func run_on_save_setting() -> bool:
    var value: Variant = ProjectSettings.get_setting(RUN_ON_SAVE_SETTING, true)
    return value == true


## Whether saving the script at [param path] should regenerate the helpers: a script that
## extends DbModel, outside the excluded folders and the output folder.
static func is_model_script(path: String) -> bool:
    if not path.ends_with(".gd") or not FileAccess.file_exists(path):
        return false
    var exclude: PackedStringArray = exclude_setting()
    exclude.append(output_dir_setting())
    if _is_excluded(path, exclude):
        return false
    var loaded: Resource = load(path)
    if not loaded is GDScript:
        return false
    var script: GDScript = loaded
    return _extends_model(script)


## Every script with a class_name that extends DbModel, outside [param exclude], by path.
## Only those scripts are loaded: a game script that names an autoload does not compile in a
## command-line run, which has no autoloads.
static func find_models(exclude: PackedStringArray) -> Array[GDScript]:
    var models: Array[GDScript] = []
    for path: String in model_paths(ProjectSettings.get_global_class_list(), exclude):
        var loaded: Resource = load(path)
        if loaded is GDScript:
            var script: GDScript = loaded
            if _extends_model(script):
                models.append(script)
    return models


## The paths of the GDScript classes in [param classes] (entries of
## [method ProjectSettings.get_global_class_list]) whose bases lead to DbModel, outside
## [param exclude], sorted. Reads only the class list. Each entry's base is the nearest named
## class above it, so a model below an unnamed base script is found too.
static func model_paths(
    classes: Array[Dictionary],
    exclude: PackedStringArray,
) -> PackedStringArray:
    var bases: Dictionary[StringName, StringName] = { }
    for entry: Dictionary in classes:
        bases[StringName(str(entry["class"]))] = StringName(str(entry.get("base", "")))
    var paths: PackedStringArray = []
    for entry: Dictionary in classes:
        var path: String = entry["path"]
        var language: String = str(entry.get("language", ""))
        if language != "GDScript" or _is_excluded(path, exclude):
            continue
        var base: StringName = bases.get(StringName(str(entry["class"])), &"")
        var seen: Dictionary[StringName, bool] = { }
        while bases.has(base) and base != &"DbModel" and not seen.has(base):
            seen[base] = true
            base = bases[base]
        if base == &"DbModel":
            paths.append(path)
    paths.sort()
    return paths


## The source of every model's file, keyed by path, and the problems found:
## [code]{"files": {path: source}, "errors": PackedStringArray}[/code].
static func build(models: Array, output_dir: String) -> Dictionary:
    var registry: DbRegistry = DbRegistry.new()
    var errors: PackedStringArray = registry.compile(models)
    var files: Dictionary = { }
    if errors.is_empty():
        for table: DbTable in registry.ordered:
            var model_name: String = table.model_script.get_global_name()
            if model_name.is_empty():
                errors.append("%s has no class_name, so it gets no helper" % table.model_name)
                continue
            var path: String = output_dir.path_join(model_name.to_snake_case() + "_db.gd")
            var source: String = generate(table)
            if source.begins_with("ERROR:"):
                errors.append(source.trim_prefix("ERROR:"))
                continue
            files[path] = source
    return { "files": files, "errors": errors }


## The helper source for [param table], or "ERROR:" and a message.
static func generate(table: DbTable) -> String:
    var model: String = table.model_script.get_global_name()
    var helper: String = model + "Db"
    var problem: String = _check_names(table)
    if not problem.is_empty():
        return "ERROR:" + problem
    var out: PackedStringArray = []
    out.append("%s from %s." % [MARKER, table.model_script.resource_path])
    out.append("# Do not edit: run the generator again after changing the model.")
    out.append("class_name " + helper)
    out.append("extends RefCounted")
    out.append("## Typed queries and names for [%s], generated from its schema." % model)
    out.append("")
    out.append("")
    _emit_find(out, table, model)
    out.append("")
    out.append("")
    out.append("## A query for [%s] rows. Conditions work as in [DbWhere]." % model)
    out.append("static func query(db: Db) -> Query:")
    out.append("    return Query.new(db.select(%s))" % model)
    out.append("")
    out.append("")
    out.append("## Changes matching [%s] rows: set fields, add conditions, then execute()." % model)
    out.append("static func update(db: Db) -> Update:")
    out.append("    return Update.new(db.update_all(%s))" % model)
    out.append("")
    out.append("")
    out.append("## Deletes matching [%s] rows: add conditions, then execute()." % model)
    out.append("static func delete(db: Db) -> Delete:")
    out.append("    return Delete.new(db.delete_all(%s))" % model)
    out.append("")
    out.append("")
    out.append("## Column names of [%s]." % model)
    out.append("class Field:")
    for column: DbColumn in table.columns:
        out.append('    const %s: StringName = &"%s"' % [column.name.to_upper(), column.name])
    if not table.relations.is_empty():
        out.append("")
        out.append("")
        out.append(
            "## Relation names of [%s], for paths in with(), Db.load() and Db.save_tree()." % model
        )
        out.append("class Rel:")
        for relation_name: String in table.relations:
            out.append('    const %s: String = "%s"' % [relation_name.to_upper(), relation_name])
    _emit_query(out, table, model)
    _emit_update(out, table, model)
    _emit_delete(out, table, model)
    return "\n".join(out) + "\n"


static func _emit_find(out: PackedStringArray, table: DbTable, model: String) -> void:
    var params: PackedStringArray = ["db: Db"]
    var names: PackedStringArray = []
    for key: String in table.primary_key:
        params.append("%s: %s" % [key, _value_type(table.column(key))])
        names.append(key)
    var key_arg: String = names[0] if names.size() == 1 else "[%s]" % ", ".join(names)
    out.append("## The row with this primary key, or null.")
    _emit_signature(out, "static func find", params, model, "")
    out.append("    return db.find(%s, %s)" % [model, key_arg])


static func _emit_query(out: PackedStringArray, table: DbTable, model: String) -> void:
    _emit_class_head(
        out,
        "## A query for [%s] rows, made by query()." % model,
        "Query",
        "DbQuery",
        "_query",
    )
    for column: DbColumn in table.columns:
        _emit_where_methods(out, column, "_query", "Query")
        _blank(out)
        _emit_signature(
            out,
            "    func order_by_" + column.name,
            ["descending: bool = false"],
            "Query",
            "    ",
        )
        out.append("        _query.order_by(%s, descending)" % _field(column))
        out.append("        return self")
        _blank(out)
        var value_type: String = _value_type(column)
        if _is_scalar(column):
            _emit_signature(
                out,
                "    func pluck_" + column.name,
                [],
                "Array[%s]" % value_type,
                "    ",
            )
            out.append("        var values: Array[%s] = []" % value_type)
            out.append("        values.assign(_query.pluck(%s))" % _field(column))
            out.append("        return values")
        else:
            _emit_signature(out, "    func pluck_" + column.name, [], "Array", "    ")
            out.append("        return _query.pluck(%s)" % _field(column))
    for relation_name: String in table.relations:
        var constant: String = "Rel." + relation_name.to_upper()
        _blank(out)
        out.append(
            "    ## Also loads %s; [param nested] continues the path from there." % relation_name
        )
        _emit_signature(
            out,
            "    func with_" + relation_name,
            ["nested: String = \"\""],
            "Query",
            "    ",
        )
        out.append(
            "        _query.with(%s if nested.is_empty() else %s + \".\" + nested)"
            % [constant, constant]
        )
        out.append("        return self")
    _emit_conditions_passthrough(out, "_query", "Query")
    _emit_methods(
        out,
        [
            ["func limit(row_count: int) -> Query:", "_query.limit(row_count)", "return self"],
            ["func offset(row_count: int) -> Query:", "_query.offset(row_count)", "return self"],
            [
                "func all() -> Array[%s]:" % model,
                "var rows: Array[%s] = []" % model,
                "rows.assign(_query.all())",
                "return rows",
            ],
            ["func first() -> %s:" % model, "return _query.first()"],
            ["func count() -> int:", "return _query.count()"],
            ["func exists() -> bool:", "return _query.exists()"],
            ["func to_sql() -> String:", "return _query.to_sql()"],
            [
                "## The untyped query underneath, for what this class does not cover.",
                "func db_query() -> DbQuery:",
                "return _query",
            ],
        ],
    )


static func _emit_update(out: PackedStringArray, table: DbTable, model: String) -> void:
    _emit_class_head(
        out,
        "## Changes every matching [%s] row, made by update(). See [DbUpdate]." % model,
        "Update",
        "DbUpdate",
        "_update",
    )
    for column: DbColumn in table.columns:
        _blank(out)
        _emit_signature(
            out,
            "    func set_" + column.name,
            ["value: " + _value_type(column)],
            "Update",
            "    ",
        )
        out.append("        _update.set_field(%s, value)" % _field(column))
        out.append("        return self")
        if column.nullable:
            _blank(out)
            _emit_signature(out, "    func set_%s_null" % column.name, [], "Update", "    ")
            out.append("        _update.set_field(%s, null)" % _field(column))
            out.append("        return self")
    for column: DbColumn in table.columns:
        _emit_where_methods(out, column, "_update", "Update")
    _emit_conditions_passthrough(out, "_update", "Update")
    _emit_methods(
        out,
        [
            [
                "## Allows running without conditions, changing every row.",
                "func all_rows() -> Update:",
                "_update.all_rows()",
                "return self",
            ],
            [
                "## Runs the update. Returns how many rows changed, or -1 on failure.",
                "func execute() -> int:",
                "return _update.execute()",
            ],
            ["func db_update() -> DbUpdate:", "return _update"],
        ],
    )


static func _emit_delete(out: PackedStringArray, table: DbTable, model: String) -> void:
    _emit_class_head(
        out,
        "## Deletes every matching [%s] row, made by delete(). See [DbDelete]." % model,
        "Delete",
        "DbDelete",
        "_delete",
    )
    for column: DbColumn in table.columns:
        _emit_where_methods(out, column, "_delete", "Delete")
    _emit_conditions_passthrough(out, "_delete", "Delete")
    _emit_methods(
        out,
        [
            [
                "## Allows running without conditions, deleting every row.",
                "func all_rows() -> Delete:",
                "_delete.all_rows()",
                "return self",
            ],
            [
                "## Runs the delete. Returns how many rows were deleted, or -1 on failure.",
                "func execute() -> int:",
                "return _delete.execute()",
            ],
            ["func db_delete() -> DbDelete:", "return _delete"],
        ],
    )


static func _emit_class_head(
    out: PackedStringArray,
    doc: String,
    class_label: String,
    wrapped_type: String,
    member: String,
) -> void:
    _blank(out)
    out.append(doc)
    out.append("class %s:" % class_label)
    out.append("    extends RefCounted")
    out.append("")
    out.append("    var %s: %s" % [member, wrapped_type])
    out.append("")
    out.append("")
    out.append("    func _init(wrapped: %s) -> void:" % wrapped_type)
    out.append("        %s = wrapped" % member)


## The typed condition methods of one column, calling [param member] and returning
## [param class_label].
static func _emit_where_methods(
    out: PackedStringArray,
    column: DbColumn,
    member: String,
    class_label: String,
) -> void:
    var name: String = column.name
    var constant: String = _field(column)
    var value_type: String = _value_type(column)
    for call: String in ["where", "or_where"]:
        _blank(out)
        _emit_signature(
            out,
            "    func %s_%s" % [call, name],
            ["op: String", "value: " + value_type],
            class_label,
            "    ",
        )
        out.append("        %s.%s(%s, op, value)" % [member, call, constant])
        out.append("        return self")
    if _is_scalar(column):
        for pair: Array in [
            ["where_%s_in", "where_in"],
            ["or_where_%s_in", "or_where_in"],
            ["where_%s_not_in", "where_not_in"],
        ]:
            _blank(out)
            _emit_signature(
                out,
                "    func " + str(pair[0]) % name,
                ["values: Array[%s]" % value_type],
                class_label,
                "    ",
            )
            out.append("        %s.%s(%s, values)" % [member, pair[1], constant])
            out.append("        return self")
    if column.kind == DbColumn.Kind.INT or column.kind == DbColumn.Kind.FLOAT:
        _blank(out)
        _emit_signature(
            out,
            "    func where_%s_between" % name,
            ["low: " + value_type, "high: " + value_type],
            class_label,
            "    ",
        )
        out.append("        %s.where_between(%s, low, high)" % [member, constant])
        out.append("        return self")
    if column.nullable:
        for pair: Array in [
            ["where_%s_null", "where_null"],
            ["or_where_%s_null", "or_where_null"],
            ["where_%s_not_null", "where_not_null"],
        ]:
            _blank(out)
            _emit_signature(out, "    func " + str(pair[0]) % name, [], class_label, "    ")
            out.append("        %s.%s(%s)" % [member, pair[1], constant])
            out.append("        return self")


static func _emit_conditions_passthrough(
    out: PackedStringArray,
    member: String,
    class_label: String,
) -> void:
    _emit_methods(
        out,
        [
            [
                "func where_group(body: Callable) -> %s:" % class_label,
                "%s.where_group(body)" % member,
                "return self",
            ],
            [
                "func or_where_group(body: Callable) -> %s:" % class_label,
                "%s.or_where_group(body)" % member,
                "return self",
            ],
            [
                "func where_raw(sql: String, args: Array = []) -> %s:" % class_label,
                "%s.where_raw(sql, args)" % member,
                "return self",
            ],
        ],
    )


## Writes methods given as [doc lines..., signature, body lines...], inside a class.
static func _emit_methods(out: PackedStringArray, methods: Array) -> void:
    for item: Variant in methods:
        var lines: Array = item
        _blank(out)
        var body_start: int = 0
        while str(lines[body_start]).begins_with("##"):
            out.append("    " + str(lines[body_start]))
            body_start += 1
        out.append("    " + str(lines[body_start]))
        for i: int in range(body_start + 1, lines.size()):
            out.append("        " + str(lines[i]))


static func _field(column: DbColumn) -> String:
    return "Field." + column.name.to_upper()


## Writes "func name(params) -> type:", wrapping the parameters one per line when the
## line would be too long, the way the formatter wraps them.
static func _emit_signature(
    out: PackedStringArray,
    head: String,
    params: PackedStringArray,
    return_type: String,
    indent: String,
) -> void:
    var line: String = "%s(%s) -> %s:" % [head, ", ".join(params), return_type]
    if line.length() <= MAX_LINE or params.is_empty():
        out.append(line)
        return
    out.append(head + "(")
    for param: String in params:
        out.append("%s    %s," % [indent, param])
    out.append("%s) -> %s:" % [indent, return_type])


static func _blank(out: PackedStringArray) -> void:
    out.append("")
    out.append("")


## The type a value of [param column] has in a where() call: the declared type, or the stored
## type of a Variant field.
static func _value_type(column: DbColumn) -> String:
    if column.var_type != TYPE_NIL:
        return column.type_text
    if column.kind == DbColumn.Kind.CUSTOM or column.value_type == TYPE_NIL:
        return "Variant"
    return type_string(column.value_type)


static func _is_scalar(column: DbColumn) -> bool:
    var value_type: String = _value_type(column)
    return column.kind in SCALAR_KINDS and value_type != "Variant"


## Every method name of a generated class must be unique, and no key field may be named "db".
static func _check_names(table: DbTable) -> String:
    var clashes: PackedStringArray = []
    var query_names: Dictionary = { }
    var update_names: Dictionary = { }
    var delete_names: Dictionary = { }
    _claim(query_names, QUERY_METHODS, "the query itself", clashes, "Query")
    _claim(update_names, UPDATE_METHODS, "the update itself", clashes, "Update")
    _claim(delete_names, DELETE_METHODS, "the delete itself", clashes, "Delete")
    for column: DbColumn in table.columns:
        var source: String = "field '%s'" % column.name
        var conditions: PackedStringArray = _where_method_names(column)
        var query_own: PackedStringArray = conditions.duplicate()
        query_own.append_array(["order_by_" + column.name, "pluck_" + column.name])
        _claim(query_names, query_own, source, clashes, "Query")
        var update_own: PackedStringArray = conditions.duplicate()
        update_own.append("set_" + column.name)
        if column.nullable:
            update_own.append("set_%s_null" % column.name)
        _claim(update_names, update_own, source, clashes, "Update")
        _claim(delete_names, conditions, source, clashes, "Delete")
    for relation_name: String in table.relations:
        var source: String = "relation '%s'" % relation_name
        _claim(query_names, ["with_" + relation_name], source, clashes, "Query")
    if "db" in table.primary_key:
        clashes.append("key field 'db' (clashes with find()'s db parameter)")
    if clashes.is_empty():
        return ""
    return "%s: generated names clash, rename the fields: %s" % [
        table.model_name,
        ", ".join(clashes),
    ]


static func _claim(
    taken: Dictionary,
    names: PackedStringArray,
    source: String,
    clashes: PackedStringArray,
    class_label: String,
) -> void:
    for method: String in names:
        if taken.has(method):
            clashes.append("%s.%s (from %s and %s)" % [class_label, method, source, taken[method]])
        else:
            taken[method] = source


static func _where_method_names(column: DbColumn) -> PackedStringArray:
    var name: String = column.name
    var methods: PackedStringArray = ["where_" + name, "or_where_" + name]
    if _is_scalar(column):
        methods.append_array(
            ["where_%s_in" % name, "or_where_%s_in" % name, "where_%s_not_in" % name]
        )
    if column.kind == DbColumn.Kind.INT or column.kind == DbColumn.Kind.FLOAT:
        methods.append("where_%s_between" % name)
    if column.nullable:
        methods.append_array(
            ["where_%s_null" % name, "or_where_%s_null" % name, "where_%s_not_null" % name]
        )
    return methods


static func _extends_model(script: GDScript) -> bool:
    var base: Script = script.get_base_script()
    while base != null:
        if base == DbModel:
            return true
        base = base.get_base_script()
    return false


static func _is_excluded(path: String, exclude: PackedStringArray) -> bool:
    for folder: String in exclude:
        if path == folder or path.begins_with(folder + "/"):
            return true
    return false


static func _generated_files(output_dir: String) -> PackedStringArray:
    var found: PackedStringArray = []
    if not DirAccess.dir_exists_absolute(output_dir):
        return found
    for file_name: String in DirAccess.get_files_at(output_dir):
        if not file_name.ends_with(".gd"):
            continue
        var path: String = output_dir.path_join(file_name)
        if FileAccess.get_file_as_string(path).begins_with(MARKER):
            found.append(path)
    return found


## What a run did or would do.
class Report:
    extends RefCounted

    ## Problems that stop generation, such as an invalid model or a name clash.
    var errors: PackedStringArray = []
    ## Generated files that were written, or that are missing or stale in check mode.
    var changed: PackedStringArray = []
    ## Generated files without a model, removed, or to remove in check mode.
    var removed: PackedStringArray = []


    ## Whether generated files match the models.
    func is_current() -> bool:
        return errors.is_empty() and changed.is_empty() and removed.is_empty()
